# /etc/systemd/system/yt-kombain.service
[Unit]
Description=YouTube Kombain
After=network-online.target
Wants=network-online.target

[Service]
User=kombain
Group=kombain
WorkingDirectory=/srv/kombain
EnvironmentFile=-/srv/kombain/.env
Environment=APP_ENV=production
Environment=TRUST_PROXY=true
Environment=TEMP_DIR=/var/tmp/yt-kombain
ExecStart=/srv/kombain/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --no-access-log --timeout-graceful-shutdown 10
Restart=always
RestartSec=3

# Защита процесса
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/tmp/yt-kombain
MemoryMax=1G

[Install]
WantedBy=multi-user.target

# Скопируйте в .env и поменяйте под себя. Все параметры необязательные.

# Публичный адрес сайта — используется в canonical, sitemap и Open Graph
SITE_URL=http://localhost:8000
# development | production (в production отключена документация API)
APP_ENV=development
# true, если приложение стоит за nginx/Caddy: IP клиента берётся из X-Real-IP
TRUST_PROXY=false

# Временная папка для скачивания (по умолчанию — системная TEMP/yt-kombain)
# TEMP_DIR=/var/tmp/yt-kombain

# Путь к ffmpeg. По умолчанию ищется в PATH, затем используется сборка из пакета imageio-ffmpeg
# FFMPEG_PATH=/usr/bin/ffmpeg
# JS-движок для yt-dlp: deno, node или bun, можно с путём — node:/usr/bin/node
# YTDLP_JS_RUNTIMES=deno
# Cookies в формате Netscape — если YouTube начал требовать подтверждение «вы не бот»
# YTDLP_COOKIES_FILE=/etc/yt-kombain/cookies.txt
# Прокси для запросов к YouTube
# YTDLP_PROXY=socks5://127.0.0.1:1080

# Ограничения скачивания
MAX_FILESIZE_MB=1024
MAX_DOWNLOAD_DURATION_MIN=240
DOWNLOAD_TIMEOUT_S=900
FILE_TTL_S=900
MIN_FREE_DISK_MB=1024

# Ограничения остальных операций
INFO_TIMEOUT_S=45
JOB_TIMEOUT_S=240
MAX_COMMENTS=5000
MAX_PLAYLIST_ITEMS=3000

# Редактор Shorts и Stories
EDITOR_MAX_SOURCE_MIN=30
EDITOR_MAX_CLIP_S=180
EDITOR_SESSION_TTL_S=3600
EDITOR_RENDER_TIMEOUT_S=600
EDITOR_MAX_AUDIO_MB=25
EDITOR_RENDER_WORKERS=1
EDITOR_MAX_SESSIONS=20

# Параллельность
JOB_WORKERS=4
DOWNLOAD_WORKERS=2
MAX_QUEUED_JOBS=24
INFO_CONCURRENCY=6

# Лимиты на один IP
RATE_API_PER_MIN=90
RATE_HEAVY_PER_MIN=15
RATE_DOWNLOAD_PER_HOUR=20
MAX_JOBS_PER_IP=2
